# Server-side only. Never prefix these with VITE_.
# An HTTPS OpenAI-compatible chat-completions endpoint.
NCG_TRANSLATION_URL=
NCG_TRANSLATION_KEY=
NCG_TRANSLATION_MODEL=

# YouVersion Platform app key. Accept publisher licenses in its portal first.
NCG_YOUVERSION_APP_KEY=

# Public client configuration only. Never use a secret/service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Web push public key (safe to include in the client build).
VITE_VAPID_PUBLIC_KEY=
# Trusted scheduled worker only. NEVER use VITE_ for these secret values.
NCG_SUPABASE_URL=
NCG_SUPABASE_SERVICE_ROLE_KEY=
NCG_VAPID_PUBLIC_KEY=
NCG_VAPID_PRIVATE_KEY=

# Public HTTPS origin of the production server; localhost only for local verification.
NCG_PUBLIC_ORIGIN=http://127.0.0.1:4311
NCG_PORT=4311
NCG_BIND=127.0.0.1
# Set only behind a loopback reverse proxy that REPLACES X-Forwarded-For with the real client IP.
NCG_TRUST_LOOPBACK_PROXY=0
NCG_TRANSLATION_DAILY_LIMIT=3000
